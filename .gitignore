# Node dependencies
node_modules/
dist/
dist-ssr/
*.local

# Lokale Deploy-Zugangsdaten; nur die geheimnisfreie Vorlage bleibt versioniert.
.env
.env.*
!.env.example

# System files
.DS_Store
Thumbs.db

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Konfliktkopien von Synchronisationswerkzeugen
*conflict*

# Agent / Assistant metadata
.claude/
.gemini/
scratch/
.commit-lock

# Raw geodata download caches
.cache/
# Frueherer Ort; eine liegengebliebene Kopie bleibt untracked, bis der naechste
# prepare_data-Lauf sie nach .cache/geodata verschiebt.
public/data/ne_*

# Diagnostic scripts
scripts/test_modes_simulation.js




# Lokale Diagnosekopie des serverseitigen Deploy-Manifests (maschinenlokal)
.deploy-manifest.json
.deploy-manifest.json.tmp

# Python-Bytecode (deploy.py-Import beim Login-Test)
__pycache__/

# Semantische QA-Laeufe sind Arbeitsprotokolle eines Sprachmodells, kein
# Projektinhalt: lokal erzeugen, auswerten und ausserhalb des Repos ablegen.
docs/qa_reports/

# Eigene Kopien der Konzeptbilder (rund 9000 Dateien, mehrere hundert MB).
# Sie entstehen aus `npm run mirror:images`; versioniert sind nur das Skript
# und das Manifest public/data/image_mirror.json.
public/images/concepts/
